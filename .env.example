# Snowflake Connection Configuration (Read-Only App Role)
# Account identifier format: <orgname>-<accountname> or <account_locator>.<region>
SNOWFLAKE_ACCOUNT=your_org_or_account_locator
SNOWFLAKE_USER=DATAMIND_APP_USER
SNOWFLAKE_PASSWORD=your_secure_password_here
SNOWFLAKE_ROLE=DATAMIND_APP_ROLE
SNOWFLAKE_WAREHOUSE=DATAMIND_WH
SNOWFLAKE_DATABASE=DATAMIND_DB
SNOWFLAKE_SCHEMA=SALES

# Ollama Local Gemma Configuration
OLLAMA_MODEL=gemma3n:e2b
OLLAMA_HOST=http://localhost:11434

# Dataset Configuration Path (relative to repo root)
DATASET_CONFIG=config/datasets/tpch.yaml
